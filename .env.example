# Copy to .env (git-ignored) inside WSL2 and fill in real values there.
# Never commit real values. Never paste them into chat.

# Tavily (G08). Required only for the evidence step and the bonus award.
TAVILY_API_KEY=replace-me

# Nebius Token Factory (G04). The npa CLI can also hold this in its own
# credentials file (mode 0600); see the pinned nebius-physical-ai docs.
NEBIUS_TOKEN_FACTORY_API_KEY=replace-me
# Optional override only. The provider default is https://api.tokenfactory.nebius.com/v1/
# NEBIUS_TOKEN_FACTORY_BASE_URL=

# Chosen NVIDIA model ID, copied from `npa workbench token-factory models` output in G04.
# Do not invent one.
SKULD_NEMOTRON_MODEL_ID=replace-me-from-catalog

# Local paths
SKULD_ARTIFACT_ROOT=./runs
